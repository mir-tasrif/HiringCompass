# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
APP_SECRET_KEY=

# PostgreSQL
POSTGRES_DB=hiringcompass
POSTGRES_USER=hiringcompass
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://hiringcompass:CHANGE_ME@localhost:5432/hiringcompass

# LLM provider (configure when provider is selected)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Google Speech-to-Text (configure for interview transcription)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# WebRTC / managed RTC (provider and values to be selected)
RTC_PROVIDER=
RTC_API_KEY=
RTC_API_SECRET=

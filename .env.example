# ============================================================
# HiringCompass - environment template (copy to .env, never commit .env)
# ============================================================

# ---------- Application ----------
APP_ENV=development
APP_NAME=HiringCompass
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173

# ---------- Logging (isolated volumes) ----------
LOG_LEVEL=INFO
LOG_DIR=/app/logs
ERROR_DIR=/app/errors
LOG_ROTATE_MB=10
LOG_BACKUP_COUNT=10

# ---------- PostgreSQL ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hiringcompass
POSTGRES_USER=hc_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://hc_user:change_me@db:5432/hiringcompass
CHECKPOINT_DB_URL=postgresql://hc_user:change_me@db:5432/hiringcompass

# ---------- File storage ----------
FILE_STORAGE_DIR=/app/storage
EXPORT_DIR=/app/storage/exports
QUARANTINE_DIR=/app/storage/quarantine
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=15
ALLOWED_UPLOAD_TYPES=application/pdf

# ---------- Auth ----------
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
INVITE_TOKEN_TTL_HOURS=72
SEED_INTERVIEWER_EMAIL=interviewer@example.com
SEED_INTERVIEWER_PASSWORD=change_me

# ---------- LLM (chat): switch with ONE value ----------
# local  = Ollama on this machine (default)
# remote = any OpenAI-compatible API (fill the three LLM_REMOTE_* values below)
LLM_PROFILE=local
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# Free remote tiers rate-limit hard: use 1 when LLM_PROFILE=remote
LLM_MAX_CONCURRENCY=2

LLM_LOCAL_BASE_URL=http://ollama:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen2.5:7b-instruct
LLM_LOCAL_JSON_MODE=json_schema

LLM_REMOTE_BASE_URL=
LLM_REMOTE_API_KEY=
LLM_REMOTE_MODEL=
# json_schema = provider enforces the full schema; json_object = plain JSON mode (most widely supported)
LLM_REMOTE_JSON_MODE=json_object

# ---------- Embeddings (always local Ollama; vector column is 768-dim) ----------
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
RAG_TOP_K=5
RAG_NAMESPACE_COMPANY=company_hiring
RAG_NAMESPACE_TECHNICAL=technical_docs
RAG_CORPUS_DIR=/app/app/rag/corpora

# ---------- Speech-to-text ----------
# faster_whisper = local default | google = use for the final run
STT_PROVIDER=faster_whisper
STT_LANGUAGE=en-US
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_stt.json
GOOGLE_STT_MODEL=latest_long
GOOGLE_STT_STREAM_ROTATE_SECONDS=270
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
STT_SAMPLE_RATE=16000

# ---------- Real-time video (LiveKit) ----------
RTC_PROVIDER=livekit
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_min_32_chars_long_secret
RECONNECT_GRACE_SECONDS=60

# ---------- Invitation delivery ----------
INVITE_DELIVERY=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hiring@hiringcompass.local

# ---------- Worker ----------
WORKER_ID=worker-1
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_MAX_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_BASE_SECONDS=5

# ---------- Domain thresholds ----------
CV_BATCH_TARGET_SECONDS=300
OCR_ENABLED=true
OCR_LANGUAGE=eng
TESSERACT_CMD=/usr/bin/tesseract
INTEGRITY_POLICY_VERSION=1.0
INTEGRITY_MIN_FONT_PT=4